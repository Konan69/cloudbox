{
  "provider": "boat",
  "name": "dev",
  "boat": {
    "type": "default",
    "ttlSeconds": 7200,
    "environment": "base"
  },
  "sshPublicKeyPath": "~/.ssh/ascii_box_ed25519.pub",
  "idleMinutes": 30,
  "t3": {
    "settingsParity": {
      "enabled": false,
      "keybindings": false
    }
  },
  "identity": {
    "paths": [],
    "excludes": [
      "sessions/",
      "npm/",
      "git/",
      "*.jsonl",
      "pi-debug.log",
      "cache*"
    ],
    "maxTransferMb": 300
  },
  "repos": [],
  "boxUser": "user"
}
