{
  "provider": "boat",
  "name": "dev",
  "boat": {
    "type": "default",
    "ttlSeconds": 7200,
    "environment": "base"
  },
  "sshPublicKeyPath": "~/.ssh/ascii_box_ed25519.pub",
  "idleMinutes": 30,
  "t3": {
    "settingsParity": {
      "enabled": true,
      "keybindings": true
    }
  },
  "identity": {
    "paths": [
      "~/.claude/settings.json",
      "~/.claude/CLAUDE.md",
      "~/.claude/skills/",
      "~/.agents/skills/",
      "~/.claude/projects/-home-dev/memory/",
      "~/.pi/agent/auth.json",
      "~/.pi/agent/settings.json",
      "~/.pi/agents/",
      "~/.pi/agent/AGENTS.md",
      "~/.config/gh/"
    ],
    "excludes": [
      "sessions/",
      "npm/",
      "git/",
      "*.jsonl",
      "pi-debug.log",
      "cache*"
    ],
    "maxTransferMb": 300
  },
  "repos": [],
  "boxUser": "user"
}
