{
  "provider": "gcp",
  "name": "dev",
  "gcp": {
    "project": "your-gcp-project-id",
    "zone": "europe-west2-a",
    "machineType": "n2-standard-16",
    "bootDiskGb": 80,
    "dataDiskGb": 300,
    "dataDiskType": "pd-ssd",
    "credentials": "adc"
  },
  "sshCidr": "203.0.113.10/32",
  "sshPublicKeyPath": "~/.ssh/id_ed25519.pub",
  "idleMinutes": 30,
  "t3": {
    "repoUrl": "https://github.com/example/t3code.git",
    "branch": "main"
  },
  "identity": {
    "paths": [
      "~/.claude/settings.json",
      "~/.claude/CLAUDE.md",
      "~/.claude/skills/",
      "~/.claude/projects/-home-dev/memory/",
      "~/.pi/agent/auth.json",
      "~/.pi/agent/settings.json",
      "~/.pi/agent/agents/",
      "~/.pi/agent/AGENTS.md",
      "~/.config/gh/"
    ],
    "excludes": [
      "sessions/",
      "npm/",
      "git/",
      "*.jsonl",
      "pi-debug.log",
      "cache*"
    ],
    "maxTransferMb": 300
  },
  "boxUser": "dev"
}
