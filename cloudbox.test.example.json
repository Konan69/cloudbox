{
  "provider": "gcp",
  "name": "dev",
  "gcp": {
    "project": "your-gcp-project-id",
    "zone": "europe-west2-a",
    "machineType": "n2-standard-8",
    "bootDiskGb": 30,
    "dataDiskGb": 100,
    "dataDiskType": "pd-balanced",
    "credentials": "adc"
  },
  "wake": {
    "allowedOrigins": [
      "https://your-t3-client.example.com"
    ]
  },
  "sshPublicKeyPath": "~/.ssh/id_ed25519.pub",
  "idleMinutes": 10,
  "t3": {
    "repoUrl": "https://github.com/pingdotgg/t3code.git",
    "branch": "main",
    "settingsParity": {
      "enabled": false,
      "keybindings": false
    }
  },
  "identity": {
    "paths": [],
    "excludes": [
      "sessions/",
      "npm/",
      "git/",
      "*.jsonl",
      "pi-debug.log",
      "cache*"
    ],
    "maxTransferMb": 300
  },
  "bootstrap": {
    "paths": [],
    "excludes": [
      "node_modules/",
      ".cache/"
    ],
    "maxTransferMb": 2000
  },
  "repos": [],
  "boxUser": "dev"
}
