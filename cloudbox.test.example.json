{
  "provider": "gcp",
  "name": "dev-acceptance",
  "gcp": {
    "project": "your-gcp-project-id",
    "zone": "europe-west2-a",
    "machineType": "n2-standard-8",
    "bootDiskGb": 30,
    "dataDiskGb": 100,
    "dataDiskType": "pd-balanced",
    "credentials": "adc"
  },
  "wake": {
    "allowedOrigins": ["https://your-t3-client.example.com"]
  },
  "sshPublicKeyPath": "~/.ssh/id_ed25519.pub",
  "idleMinutes": 10,
  "t3": {
    "repoUrl": "https://github.com/example/t3code.git",
    "branch": "main"
  },
  "identity": {
    "paths": [
      "~/.claude/settings.json",
      "~/.claude/CLAUDE.md",
      "~/.claude/skills/",
      "~/.agents/skills/",
      "~/.claude/projects/-home-dev/memory/",
      "~/.pi/agent/auth.json",
      "~/.pi/agent/settings.json",
      "~/.pi/agents/",
      "~/.pi/agent/AGENTS.md",
      "~/.config/gh/"
    ],
    "excludes": [
      "sessions/",
      "npm/",
      "git/",
      "*.jsonl",
      "pi-debug.log",
      "cache*"
    ],
    "maxTransferMb": 300
  },
  "boxUser": "dev"
}
