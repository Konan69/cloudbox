{
  "provider": "aws",
  "name": "dev",
  "region": "eu-west-2",
  "instanceType": "m7i.4xlarge",
  "diskGb": 300,
  "sshCidr": "203.0.113.10/32",
  "sshPublicKeyPath": "~/.ssh/id_ed25519.pub",
  "idleMinutes": 30,
  "t3": {
    "repoUrl": "https://github.com/example/t3code.git",
    "branch": "main"
  },
  "identity": {
    "paths": [
      "~/.claude",
      "~/.codex",
      "~/.pi/agent",
      "~/.config/opencode",
      "~/.config/gh"
    ],
    "excludes": [
      "sessions/",
      "pi-debug.log"
    ]
  },
  "boxUser": "dev"
}
