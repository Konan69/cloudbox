{
  "name": "cloudbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "cloudbox": "./dist/cli.mjs",
    "cloudbox-machines": "./dist/machines.mjs"
  },
  "scripts": {
    "build": "pnpm build:cli && pnpm build:on-box && pnpm build:idle:aws && pnpm build:wake",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/cli.mjs --banner:js='import { createRequire } from \"node:module\"; const require = createRequire(import.meta.url);'",
    "build:on-box": "pnpm build:idle && pnpm build:machines",
    "build:idle": "esbuild src/box/idle.ts --bundle --minify --platform=node --format=esm --target=node24 --outfile=dist/idle.mjs",
    "build:idle:aws": "esbuild src/box/idle.ts --bundle --packages=external --platform=node --format=esm --target=node24 --outfile=dist/idle-aws.mjs",
    "build:machines": "esbuild src/machines/cli.ts --bundle --minify --platform=node --format=esm --target=node24 --outfile=dist/machines.mjs",
    "build:wake": "esbuild src/wake/server.ts --bundle --minify --platform=node --format=esm --target=node24 --outfile=dist/wake-service.mjs",
    "cloudbox": "node dist/cli.mjs",
    "deploy": "pnpm build:on-box && pnpm build:idle:aws && pnpm build:wake && alchemy deploy",
    "destroy": "alchemy destroy",
    "test": "pnpm build:on-box && vitest run && pnpm test:bundles",
    "test:bundles": "node scripts/verify-on-box-bundles.mjs",
    "typecheck": "tsc --noEmit",
    "check:bootstrap": "bash scripts/check-bootstrap.sh",
    "verify": "pnpm typecheck && pnpm test && pnpm check:bootstrap"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "3.1120.0",
    "@effect/platform-node": "4.0.0-rc.112",
    "alchemy": "2.0.0-beta.74",
    "effect": "4.0.0-rc.112",
    "google-auth-library": "11.0.2"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.112",
    "@types/node": "24.12.4",
    "esbuild": "0.28.2",
    "tsx": "4.20.5",
    "typescript": "6.0.3",
    "vitest": "4.1.0"
  },
  "engines": {
    "node": ">=24.10"
  },
  "packageManager": "pnpm@11.10.0"
}
